{
  "configurations": [
    {
      "name": "Linux",
      "includePath": [
        "${workspaceFolder}/**",
        "/usr/include/c++/12",       // GCC standard library includes
        "/usr/include/x86_64-linux-gnu/c++/12", // GCC platform includes
        "/usr/include",             // Standard system includes
        "/usr/local/include"       
      ],
      "defines": [],
      "compilerPath": "/usr/bin/g++",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "linux-gcc-x64",
      "browse": {
        "path": [
          "${workspaceFolder}/**",
          "/usr/include/c++/12",
          "/usr/include/x86_64-linux-gnu/c++/12",
          "/usr/include",
          "/usr/local/include"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "version": 4
}
